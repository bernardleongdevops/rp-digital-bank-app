# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./

RUN if [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi

COPY . .

# Supply configuration temporarily for builds that validate
# server environment variables. Do not bake the env file
# itself into the image.
RUN --mount=type=secret,id=app_env \
    set -a; \
    . /run/secrets/app_env; \
    set +a; \
    npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=node:node /app ./

USER node
EXPOSE 3000

CMD ["./node_modules/.bin/next", "start", \
     "-H", "0.0.0.0", "-p", "3000"]
