# ---------------------------------------------------------------------------
# Banking_App environment configuration
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and MUST NOT be committed. Every variable below is read at
# startup; if a required one is missing/empty or a URL-valued one is
# malformed, the app aborts startup and reports the offending variable.
#
# Scope key:
#   server      - server-only; never bundled into client JavaScript
#   server only - secret; MUST NOT be given a NEXT_PUBLIC_ prefix
#   public      - exposed to the browser (display/links only, no secrets)
# ---------------------------------------------------------------------------

# Canonical app URL / OIDC redirect base. (server)
# Must use scheme http, host localhost, port 3000 to match the registered
# `sandbox-web` client redirect URI.
NEXTAUTH_URL=http://localhost:3000

# App URL available to client components for display/links only. (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / JWT encryption secret. (server) No default — required.
# Generate one with, for example: `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# OIDC issuer for the Keycloak `digital-bank` realm. (server)
KEYCLOAK_ISSUER=http://localhost:8080/realms/digital-bank

# OIDC public client id registered on Keycloak. (server)
KEYCLOAK_CLIENT_ID=sandbox-web

# Sandbox gateway versioned base path. (server)
SANDBOX_API_BASE_URL=http://localhost:8081/api/v1

# Sandbox API key sent as the X-Sandbox-Key header. (server only — secret)
# Never prefix this with NEXT_PUBLIC_; doing so would leak it to the browser.
SANDBOX_API_KEY=demo-key-123
